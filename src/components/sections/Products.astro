---
import ProductCard from '../ui/ProductCard.astro';
import { landingCategories } from '../../data/products.js';
---

<section class="products section" id="productos" aria-labelledby="products-title" data-products>
  <div class="container">
    <header class="products__header" data-reveal>
      <p class="products__eyebrow">Nuestros productos</p>
      <h2 id="products-title">Algo rico para cada antojo.</h2>
      <p class="products__supporting">
        Nuestras cookies son las protagonistas. Descubre sabores para todos los antojos y otras delicias que también encontrarás en Tierra Dulce.
      </p>
    </header>

    <ul class="products__grid" role="list" data-reveal>
      {landingCategories.map((product) => (
        <li class="products__item">
          <ProductCard {...product} />
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .products {
    background: var(--color-background);
  }

  .products__header {
    max-width: var(--content-max-width);
  }

  .products__eyebrow {
    margin-block-end: var(--space-3);
    color: var(--color-primary-dark);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  .products__supporting {
    max-width: 48ch;
    margin-block-start: var(--space-3);
    color: var(--color-text-muted);
  }

  .products__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }

  .products__grid {
    margin-block-start: clamp(var(--space-6), 6vw, var(--space-8));
  }

  .products__item {
    min-width: 0;
  }


  @media (min-width: 48rem) {
    .products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }

  }

  @media (min-width: 64rem) {
    .products__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

</style>
