---
import ReviewCard from '../ui/ReviewCard.astro';
import { business } from '../../data/business.js';
import { reviews, reviewsCarouselConfig } from '../../data/reviews.js';

const currentYear = new Date().getFullYear();

const contactChannels = [
  { key: 'whatsapp', label: 'WhatsApp', value: business.whatsapp },
  { key: 'instagram', label: 'Instagram', value: business.instagram },
  { key: 'facebook', label: 'Facebook', value: business.facebook },
];
---

<footer class="site-footer" id="contacto">
  <div class="site-footer__main container">
    <div class="site-footer__contact">
      <header class="site-footer__header">
        <p class="site-footer__eyebrow">Contacto</p>
        <h2>¿Te quedó algún antojo?</h2>
        <p>
          Escríbenos o síguenos para conocer nuestros productos, novedades y momentos dulces.
        </p>
      </header>

      <ul class="contact-list" role="list">
        {contactChannels.map((channel) => (
          <li class="contact-list__item">
            <span class="contact-list__icon" aria-hidden="true">
              {
                channel.key === 'whatsapp' ? (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      d="M20 11.7a8 8 0 0 1-11.8 7L4 20l1.3-4A8 8 0 1 1 20 11.7Z M9 8.2c.2-.5.4-.5.7-.5h.5c.2 0 .4.1.5.4l.8 1.9c.1.3 0 .5-.2.7l-.6.7c-.2.2-.1.4 0 .6.7 1.2 1.7 2.1 3 2.7.3.1.5.1.7-.1l.8-1c.2-.2.4-.3.7-.2l1.8.9c.3.1.4.3.4.5 0 .3-.2 1.4-.9 2-.6.5-1.5.8-2.4.6-1.1-.2-2.5-.7-4.2-2.2-2.1-1.8-3.4-4.1-3.5-5.8 0-.8.2-1.4.6-1.9.4-.4.8-.6 1.3-.6Z"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    ></path>
                  </svg>
                ) : channel.key === 'instagram' ? (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect
                      x="3.5"
                      y="3.5"
                      width="17"
                      height="17"
                      rx="5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                    ></rect>
                    <circle
                      cx="12"
                      cy="12"
                      r="4"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                    ></circle>
                    <circle cx="17.5" cy="6.7" r="1" fill="currentColor"></circle>
                  </svg>
                ) : (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      d="M14 21v-8h2.8l.4-3H14V8.1c0-.9.3-1.5 1.6-1.5h1.8V3.9c-.6-.1-1.4-.2-2.5-.2-2.5 0-4.2 1.5-4.2 4.3v2H8v3h2.7v8H14Z"
                      fill="currentColor"
                    ></path>
                  </svg>
                )
              }
            </span>
            <div>
              <span class="contact-list__label">{channel.label}</span>
              {channel.value ? (
                <a href={channel.value} target="_blank" rel="noopener noreferrer">
                  Abrir {channel.label}
                </a>
              ) : (
                <span class="contact-list__pending">{channel.label} pendiente</span>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="reviews" data-carousel data-autoplay-interval={reviewsCarouselConfig.autoplayInterval}>
      <h2 class="reviews__title">Lo que dicen de nosotros</h2>

      <div class="reviews__viewport">
        {reviews.map((review, index) => (
          <div
            class:list={['reviews__slide', { 'is-active': index === 0 }]}
            data-carousel-slide
            aria-hidden={index === 0 ? 'false' : 'true'}
            inert={index === 0 ? undefined : true}
          >
            <ReviewCard {...review} />
          </div>
        ))}
      </div>

      <div class="reviews__navigation">
        <button class="reviews__control" type="button" aria-label="Review anterior" data-carousel-previous>
          <span aria-hidden="true">←</span>
        </button>

        <div class="reviews__indicators" aria-label="Seleccionar review">
          {reviews.map((review, index) => (
            <button
              class:list={['reviews__indicator', { 'is-active': index === 0 }]}
              type="button"
              aria-label={`Mostrar review ${index + 1}`}
              aria-current={index === 0 ? 'true' : undefined}
              data-carousel-indicator={index}
            ></button>
          ))}
        </div>

        <button class="reviews__control" type="button" aria-label="Review siguiente" data-carousel-next>
          <span aria-hidden="true">→</span>
        </button>
      </div>

      <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-carousel-status></p>
    </div>
  </div>

  <div class="site-footer__bottom container">
    <p><strong>{business.name}</strong><span>{business.city}, Chile</span></p>
    <p>© {currentYear} {business.name}</p>
  </div>
</footer>

<script src="../../scripts/reviews-carousel.js"></script>

<style>
  .site-footer {
    color: var(--color-white);
    background: var(--color-brown-dark);
  }

  .site-footer :focus-visible {
    outline-color: var(--color-primary);
  }

  .site-footer__main {
    display: grid;
    gap: var(--space-8);
    padding-block: clamp(var(--space-7), 8vw, var(--space-9));
  }

  .site-footer__contact,
  .site-footer__header {
    display: grid;
    align-content: start;
  }

  .site-footer__contact {
    gap: var(--space-6);
  }

  .site-footer__header {
    max-width: 36rem;
    gap: var(--space-3);
  }

  .site-footer__header h2,
  .reviews__title {
    color: var(--color-white);
  }

  .site-footer__header > p:last-child {
    color: var(--color-accent-light);
  }

  .site-footer__eyebrow {
    color: var(--color-highlight);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  .contact-list {
    display: grid;
    gap: var(--space-3);
  }

  .contact-list__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .contact-list__icon {
    display: inline-flex;
    width: 2.625rem;
    aspect-ratio: 1;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    background: transparent;
    border: 1px solid var(--color-primary);
    border-radius: 50%;
    transition:
      color 180ms ease,
      background-color 180ms ease;
  }

  .contact-list__icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .contact-list__item > div {
    display: grid;
    gap: var(--space-1);
  }

  .contact-list__label {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
  }

  .contact-list__item a {
    color: var(--color-white);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }

  .contact-list__item a:hover,
  .contact-list__item a:focus-visible {
    color: var(--color-primary);
  }

  .contact-list__item:has(a:hover) .contact-list__icon,
  .contact-list__item:has(a:focus-visible) .contact-list__icon {
    color: var(--color-ink);
    background: var(--color-primary);
  }

  .contact-list__pending {
    color: var(--color-accent-light);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-regular);
  }

  .contact-list__item:not(:has(a)) .contact-list__icon {
    opacity: 0.72;
  }

  .reviews {
    min-width: 0;
  }

  .reviews__title {
    margin-block-end: var(--space-5);
    font-size: var(--font-size-xl);
  }

  .reviews__viewport {
    display: grid;
  }

  .reviews__slide {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateX(0.5rem);
    transition:
      visibility 0s linear 380ms,
      opacity 360ms ease,
      transform 380ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .reviews__slide.is-active {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
    transition-delay: 0s;
  }

  .reviews__navigation {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-block-start: var(--space-4);
  }

  .reviews__control,
  .reviews__indicator {
    color: var(--color-white);
    background: transparent;
    cursor: pointer;
  }

  .reviews__control {
    display: grid;
    width: 2.75rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid rgb(112 195 196 / 48%);
    border-radius: 50%;
  }

  .reviews__control:hover,
  .reviews__control:focus-visible {
    color: var(--color-ink);
    background: var(--color-primary);
  }

  .reviews__indicators {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
  }

  .reviews__indicator {
    width: 0.625rem;
    height: 0.625rem;
    padding: 0;
    border: 1px solid var(--color-primary);
    border-radius: 50%;
  }

  .reviews__indicator.is-active {
    background: var(--color-primary);
  }

  .site-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-block: var(--space-5);
    color: var(--color-accent-light);
    border-top: 1px solid rgb(112 195 196 / 28%);
    font-size: var(--font-size-xs);
  }

  .site-footer__bottom p:first-child {
    display: flex;
    flex-direction: column;
  }

  .site-footer__bottom strong {
    color: var(--color-white);
    font-weight: var(--font-weight-semibold);
  }

  @media (min-width: 48rem) {
    .site-footer__main {
      grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
      gap: clamp(var(--space-7), 7vw, var(--space-9));
    }

    .site-footer__bottom {
      flex-direction: row;
      align-items: end;
      justify-content: space-between;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reviews__slide {
      transform: none;
      transition-duration: 0.01ms;
    }
  }
</style>
