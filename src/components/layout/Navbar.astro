---
const { isCatalog = false } = Astro.props;

const navigationItems = [
  { label: 'Inicio', href: isCatalog ? '/' : '#inicio' },
  { label: 'Productos', href: isCatalog ? '/productos/' : '#productos' },
  { label: 'Nosotros', href: isCatalog ? '/#nosotros' : '#nosotros' },
  { label: 'Visítanos', href: isCatalog ? '/#visitanos' : '#visitanos' },
  { label: 'Contacto', href: isCatalog ? '/#contacto' : '#contacto' },
];
---

<header class="site-header" data-navbar>
  <nav class="navbar container" aria-label="Navegación principal">
    <a class="navbar__brand" href={isCatalog ? '/' : '#inicio'} aria-label="Tierra Dulce — Inicio">
      <img
        class="navbar__logo-image"
        src="/images/brand/logotipo_tierradulce_nv.png"
        alt="Tierra Dulce, pastelería en Villa Alemana"
        width="1536"
        height="1024"
        decoding="async"
      />
    </a>

    <button
      class="navbar__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      aria-label="Abrir menú de navegación"
      data-menu-toggle
    >
      <span class="navbar__toggle-icon" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>

    <div class="navbar__menu" id="primary-navigation" data-menu hidden>
      <ul class="navbar__links" role="list">
        {navigationItems.map((item) => (
          <li>
            <a
              class:list={['navbar__link', { active: isCatalog ? item.href === '/productos/' : item.href === '#inicio' }]}
              href={item.href}
              data-label={item.label}
              aria-current={(isCatalog ? item.href === '/productos/' : item.href === '#inicio') ? 'page' : undefined}
            >
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ul>

      <button class="navbar__order" type="button" aria-expanded="false" aria-controls="order-panel" data-order-open>Mis pedidos <span class="navbar__order-separator" aria-hidden="true">·</span> <span class="navbar__order-count" data-order-count>0</span></button>

    </div>
  </nav>
</header>

<script src="../../scripts/navigation.js"></script>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    background: var(--color-navbar-background);
    border-bottom: 1px solid rgb(16 36 35 / 16%);
    backdrop-filter: blur(0.75rem);
  }

  .navbar {
    position: relative;
    display: flex;
    min-height: var(--navbar-height);
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .navbar :focus-visible {
    outline-color: var(--color-navbar-interactive);
  }

  .navbar__brand {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    text-decoration: none;
  }

  .navbar__logo-image {
    display: block;
    width: auto;
    max-width: min(100%, var(--navbar-logo-max-width-mobile));
    height: var(--navbar-logo-height-mobile);
    object-fit: contain;
  }

  @media (max-width: 22.5rem) {
    .navbar__logo-image {
      max-width: min(100%, var(--navbar-logo-max-width-small));
    }
  }

  .navbar__toggle {
    display: inline-grid;
    width: 3rem;
    height: 3rem;
    padding: 0;
    place-items: center;
    color: var(--color-navbar-text);
    background: transparent;
    border-radius: var(--radius-pill);
    cursor: pointer;
  }

  .navbar__toggle:hover,
  .navbar__toggle:active {
    color: var(--color-navbar-interactive);
    background: transparent;
  }

  .navbar__toggle-icon {
    display: grid;
    width: 1.625rem;
    gap: 0.25rem;
  }

  .navbar__toggle-icon span {
    display: block;
    width: 100%;
    height: 0.125rem;
    background: currentColor;
    border-radius: var(--radius-pill);
    transition:
      translate var(--transition-fast),
      rotate var(--transition-fast),
      opacity var(--transition-fast);
  }

  .navbar__toggle[aria-expanded="true"] .navbar__toggle-icon span:first-child {
    translate: 0 0.375rem;
    rotate: 45deg;
  }

  .navbar__toggle[aria-expanded="true"] .navbar__toggle-icon span:nth-child(2) {
    opacity: 0;
  }

  .navbar__toggle[aria-expanded="true"] .navbar__toggle-icon span:last-child {
    translate: 0 -0.375rem;
    rotate: -45deg;
  }

  .navbar__menu {
    position: absolute;
    top: 100%;
    left: 50%;
    display: grid;
    gap: var(--space-4);
    width: 100vw;
    max-height: calc(100vh - var(--navbar-height));
    padding: var(--space-3) var(--container-gutter) var(--space-5);
    overflow-y: auto;
    background: var(--color-navbar-background);
    border-top: 1px solid rgb(16 36 35 / 16%);
    opacity: 0;
    transform: translate(-50%, -0.5rem);
    visibility: hidden;
    transition:
      opacity 250ms ease,
      transform 250ms ease,
      visibility 0s linear 250ms;
  }

  .navbar__menu[data-open] {
    opacity: 1;
    transform: translate(-50%, 0);
    visibility: visible;
    transition-delay: 0s;
  }

  .navbar__menu[hidden] {
    display: none;
  }

  .navbar__links {
    display: grid;
    gap: 0;
  }

  .navbar__link {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    text-decoration: none;
  }

  .navbar__order { display:flex; min-height:2.75rem; align-items:center; justify-content:center; gap:var(--space-1); padding-inline:var(--space-4); color:var(--color-navbar-text); background:rgb(255 255 255 / 34%); border:1px solid rgb(16 36 35 / 22%); border-radius:var(--radius-pill); font-weight:var(--font-weight-semibold); cursor:pointer; }
  .navbar__order-count { display:inline-grid; min-width:1.5rem; min-height:1.5rem; place-items:center; padding-inline:.3rem; color:var(--color-ink); background:var(--color-white); border-radius:var(--radius-pill); font-size:var(--font-size-xs); transition:background-color 200ms ease,color 200ms ease; }
  .navbar__order-count[data-active] { color:var(--color-white); background:var(--color-contrast); }
  .navbar__order:hover,.navbar__order:focus-visible { color:var(--color-navbar-interactive); background:rgb(255 255 255 / 55%); }

  .navbar__link {
    position: relative;
    display: grid;
    min-height: 3rem;
    padding: var(--space-3) 0;
    color: var(--color-navbar-text);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-medium);
  }

  .navbar__link::before,
  .navbar__link > span {
    grid-area: 1 / 1;
  }

  .navbar__link::before {
    font-weight: var(--font-weight-bold);
    content: attr(data-label);
    visibility: hidden;
  }

  .navbar__link > span {
    position: relative;
  }

  .navbar__link > span::after {
    position: absolute;
    right: 0;
    bottom: -0.35rem;
    left: 0;
    height: 0.125rem;
    content: "";
    background: var(--color-navbar-interactive);
    border-radius: var(--radius-pill);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 220ms ease;
  }

  .navbar__link:hover,
  .navbar__link:focus-visible,
  .navbar__link:active {
    color: var(--color-navbar-interactive);
  }

  .navbar__link.active {
    color: var(--color-navbar-text);
    font-weight: var(--font-weight-bold);
  }

  .navbar__link:hover > span::after,
  .navbar__link:focus-visible > span::after {
    transform: scaleX(1);
  }

  @media (min-width: 64rem) {
    .navbar__logo-image {
      max-width: var(--navbar-logo-max-width-desktop);
      height: var(--navbar-logo-height-desktop);
    }

    .navbar__toggle {
      display: none;
    }

    .navbar__menu,
    .navbar__menu[hidden] {
      position: static;
      display: flex;
      flex: 1;
      align-items: center;
      justify-content: flex-end;
      gap: clamp(var(--space-4), 2vw, var(--space-5));
      padding: 0;
      background: transparent;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      opacity: 1;
      overflow: visible;
      max-height: none;
      transform: none;
      visibility: visible;
      transition: none;
    }

    .navbar__links {
      display: flex;
      align-items: center;
      gap: var(--navbar-link-gap);
    }

    .navbar__link {
      min-height: 2.75rem;
      padding-inline: var(--space-3);
      padding-block: 0;
      font-size: var(--navbar-font-size);
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .navbar__toggle-icon span,
    .navbar__menu,
    .navbar__link > span::after {
      transition-duration: 0.01ms;
    }

    .navbar__menu {
      transform: translate(-50%, 0);
    }
  }
</style>
