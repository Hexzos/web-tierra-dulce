---
import { business } from '../../data/business.js';
const whatsappUrl = `https://wa.me/${business.whatsapp.replace(/\D/g, '')}`;
---
<!--
  TODO: Evolucionar el WhatsApp flotante hacia un asistente de atención para
  horarios, ubicación y cómo llegar, productos, medios de pago, preparación,
  pedidos anticipados, disponibilidad general, retiro en tienda, delivery,
  cobertura, costos, tiempos estimados y otras preguntas frecuentes, con
  derivación a atención humana cuando corresponda.

  Las respuestas oficiales sobre preparación, delivery y políticas comerciales
  siguen pendientes de Tierra Dulce: no inventar contenido ni afirmar que un
  pedido está listo, en preparación, pagado o confirmado sin una fuente real de
  datos o una integración futura que permita comprobarlo.

  No implementar respuestas automáticas complejas ni IA en esta etapa.
-->
<a class="whatsapp-float" href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-action="contact_whatsapp" aria-label="Contactar a Tierra Dulce por WhatsApp (abre en una pestaña nueva)">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.7a8 8 0 0 1-11.8 7L4 20l1.3-4A8 8 0 1 1 20 11.7Z M9 8.2c.2-.5.4-.5.7-.5h.5c.2 0 .4.1.5.4l.8 1.9c.1.3 0 .5-.2.7l-.6.7c-.2.2-.1.4 0 .6.7 1.2 1.7 2.1 3 2.7.3.1.5.1.7-.1l.8-1c.2-.2.4-.3.7-.2l1.8.9c.3.1.4.3.4.5 0 .3-.2 1.4-.9 2-.6.5-1.5.8-2.4.6-1.1-.2-2.5-.7-4.2-2.2-2.1-1.8-3.4-4.1-3.5-5.8 0-.8.2-1.4.6-1.9.4-.4.8-.6 1.3-.6Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
</a>
<style>
  .whatsapp-float{position:fixed;z-index:18;right:var(--space-4);bottom:var(--space-4);display:grid;width:3.25rem;height:3.25rem;place-items:center;color:var(--color-white);background:var(--color-contrast);border-radius:50%;box-shadow:var(--shadow-soft);transition:background-color var(--transition-fast),transform var(--transition-fast)}.whatsapp-float svg{width:1.65rem;height:1.65rem}.whatsapp-float:hover,.whatsapp-float:focus-visible{color:var(--color-white);background:var(--color-ink);transform:translateY(-2px)}@media(prefers-reduced-motion:reduce){.whatsapp-float{transition-duration:.01ms}.whatsapp-float:hover{transform:none}}
</style>
