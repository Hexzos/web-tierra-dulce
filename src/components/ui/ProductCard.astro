---
interface Props { id:string; name:string; category?:string; categoryLabel?:string; description:string; image?:string | null; imageAlt:string; imageWidth?:number; imageHeight?:number; ctaLabel?:string; ctaUrl?:string; external?:boolean; orderable?:boolean; isPlaceholder?:boolean; status?:string; }
const { id, name, category, categoryLabel = category, description, image, imageAlt, imageWidth, imageHeight, ctaLabel, ctaUrl, external = false, orderable = false, isPlaceholder = false, status } = Astro.props;
const isSoldOut = status === 'sold_out';
---
<article class="product-card" aria-labelledby={`${id}-title`} data-product-card={orderable ? '' : undefined} data-product-id={id} data-product-name={name} data-category={category} data-product-status={status} data-placeholder={isPlaceholder ? 'true' : undefined}>
  <div class="product-card__media">
    {image
      ? <img class="product-card__image" src={image} alt={imageAlt} width={imageWidth} height={imageHeight} loading="lazy" />
      : <div class="product-image-placeholder" role="img" aria-label={imageAlt}><!-- TODO: Replace with real Tierra Dulce product photography --></div>}
  </div>
  <div class="product-card__content">
    <p class="product-card__category">{categoryLabel}</p><h3 class="product-card__title" id={`${id}-title`}>{name}</h3><p class="product-card__description">{description}</p>
    {ctaLabel && ctaUrl && <a class="product-card__cta" href={ctaUrl} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>{ctaLabel} <span aria-hidden="true">→</span></a>}
    {isSoldOut && <p class="product-card__sold-out">AGOTADO</p>}
    {orderable && <div class="product-card__order"><div class="quantity" aria-label={`Cantidad de ${name}`}><button type="button" disabled={isSoldOut} aria-label={`Disminuir cantidad de ${name}`} data-card-decrease>−</button><output aria-live="polite" data-card-quantity>1</output><button type="button" disabled={isSoldOut} aria-label={`Aumentar cantidad de ${name}`} data-card-increase>+</button></div><button class="product-card__add" type="button" disabled={isSoldOut} data-add-order>{isSoldOut?'Agotado por ahora':'Agregar al pedido'}</button><p class="product-card__feedback" aria-live="polite" data-add-feedback></p></div>}
  </div>
</article>
<style>
  .product-card{display:flex;min-width:0;height:100%;flex-direction:column;overflow:hidden;background:var(--color-white);border:1px solid var(--color-border);border-radius:var(--radius-lg);transition:border-color var(--transition-base)}
  .product-card[hidden]{display:none}.product-card__media{position:relative;display:grid;aspect-ratio:4/3;place-items:center;overflow:hidden;background:var(--color-white)}
  .product-card__media::after{position:absolute;z-index:0;width:48%;height:8%;bottom:8%;left:50%;content:"";background:rgb(52 38 26 / 14%);border-radius:50%;filter:blur(.55rem);transform:translateX(-50%);transition:width 260ms ease,opacity 260ms ease,filter 260ms ease}
  .product-card__image{position:relative;z-index:1;width:84%;height:84%;object-fit:contain;transition:transform var(--transition-base)}
  .product-image-placeholder{position:relative;z-index:1;width:84%;height:84%;background:#f4f4f1;border:1px dashed var(--color-border);border-radius:var(--radius-md)}
  .product-card__content{display:flex;flex:1;flex-direction:column;gap:var(--space-2);padding:var(--space-5)}.product-card__category{color:var(--color-interactive);font-size:var(--font-size-xs);font-weight:var(--font-weight-semibold);letter-spacing:var(--letter-spacing-wide);text-transform:uppercase}.product-card__title{font-size:var(--font-size-xl);font-weight:var(--font-weight-semibold)}.product-card__description{color:var(--color-text-muted);font-size:var(--font-size-sm)}
  .product-card__cta{align-self:flex-start;margin-block-start:auto;padding-block-start:var(--space-2);color:var(--color-interactive);font-size:var(--font-size-sm);font-weight:var(--font-weight-semibold)}
  .product-card__order{display:grid;grid-template-columns:auto 1fr;gap:var(--space-3);align-items:center;margin-block-start:auto;padding-block-start:var(--space-4)}.quantity{display:grid;grid-template-columns:2.25rem 2rem 2.25rem;align-items:center;border:1px solid var(--color-border);border-radius:var(--radius-pill);overflow:hidden}.quantity button{min-height:2.5rem;padding:0;color:var(--color-ink);background:transparent;cursor:pointer;font-size:var(--font-size-lg)}.quantity output{text-align:center;font-weight:var(--font-weight-semibold)}
  .product-card__add{min-height:2.625rem;padding:.6rem var(--space-4);color:var(--color-white);background:var(--color-contrast);border-radius:var(--radius-pill);font-weight:var(--font-weight-semibold);cursor:pointer}.product-card__feedback{grid-column:1/-1;min-height:1.25rem;color:var(--color-primary-dark);font-size:var(--font-size-xs);font-weight:var(--font-weight-semibold)}
  .product-card__sold-out{align-self:flex-end;margin-block-start:auto;padding:.35rem .7rem;color:var(--color-brown-dark);background:rgb(237 193 118 / 45%);border-radius:var(--radius-pill);font-size:var(--font-size-xs);font-weight:var(--font-weight-bold);letter-spacing:var(--letter-spacing-wide)}.product-card__add:disabled,.quantity button:disabled{cursor:not-allowed;opacity:.55}
  @media (hover:hover) and (pointer:fine){.product-card:hover{border-color:var(--color-primary-dark)}.product-card:hover .product-card__image{transform:translateY(-.5rem)}.product-card:hover .product-card__media::after{width:58%;opacity:.82;filter:blur(.7rem)}.product-card__cta:hover,.product-card__cta:focus-visible{color:var(--color-primary-dark)}.product-card__add:hover{background:var(--color-ink)}.quantity button:hover{color:var(--color-primary-dark)}}
  @media (max-width:22.5rem){.product-card__order{grid-template-columns:1fr}.quantity{justify-self:start}.product-card__feedback{grid-column:1}}@media (prefers-reduced-motion:reduce){.product-card,.product-card__image,.product-card__media::after{transition-duration:.01ms}.product-card:hover .product-card__image{transform:none}}
</style>
