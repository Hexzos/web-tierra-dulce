---
const{mode='edit'}=Astro.props;
---
<form class="admin-product-form" data-user-form data-mode={mode} novalidate><section><h2>Información</h2><div class="admin-form-grid"><div class="admin-field"><label for="displayName">Nombre</label><input id="displayName" name="displayName" required minlength="2" maxlength="80" /></div><div class="admin-field"><label for="username">Usuario</label><input id="username" name="username" required pattern="[a-z0-9_.-]{2,50}" /></div><div class="admin-field admin-field--wide"><label for="email">Email</label><input id="email" name="email" type="email" required maxlength="254" /></div></div></section><section><h2>Acceso</h2><div class="admin-form-grid"><div class="admin-field"><label for="role">Rol</label><select id="role" name="role"><option value="editor">Editor</option><option value="admin">Admin</option></select></div><div class="admin-field" data-edit-status><label>Estado</label><output data-user-status>Activo</output></div></div></section><section data-publishing><h2>Publicación de cambios</h2><label class="admin-choice"><input type="radio" name="publishingMode" value="review_required" checked /><span><strong>Requiere revisión</strong><small>Sus cambios deberán ser aprobados antes de publicarse.</small></span></label><label class="admin-choice"><input type="radio" name="publishingMode" value="direct_publish" /><span><strong>Puede publicar sin revisión</strong><small>Podrá aplicar cambios directamente. Recomendado únicamente para editores de confianza.</small></span></label></section><div class="admin-notice"><strong>DEV ONLY</strong><p>No se enviará ningún correo ni se crearán credenciales reales.</p></div><div class="admin-context-history" data-context-history hidden></div><p data-form-message role="status"></p><div class="admin-form-actions"><button class="admin-primary-action" type="submit">{mode==='invite'?'Crear invitación local':'Guardar cambios'}</button><a class="admin-secondary-action" href="/admin/usuarios/">Cancelar</a></div></form>
