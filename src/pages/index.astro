---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import Products from '../components/sections/Products.astro';
import About from '../components/sections/About.astro';
import Location from '../components/sections/Location.astro';
import Footer from '../components/layout/Footer.astro';
import OrderPanel from '../components/layout/OrderPanel.astro';
import WhatsAppButton from '../components/layout/WhatsAppButton.astro';
---

<BaseLayout>
  <Navbar />
  <main id="main-content">
    <Hero />
    <Products />
    <About />
    <Location />
  </main>
  <Footer />
  <OrderPanel />
  <WhatsAppButton />
</BaseLayout>
