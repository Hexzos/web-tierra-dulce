---
import AdminLayout from'../../../../layouts/AdminLayout.astro';import{getDevelopmentProfiles}from'../../../../lib/admin/adminData.js';const profiles=getDevelopmentProfiles();
---
<AdminLayout title="Ver revisión" currentPath="/admin/revisiones/" profiles={profiles}><section class="admin-form-page" data-revision-detail><header class="admin-page-header"><div><p class="admin-eyebrow">Revisión editorial</p><h1 data-revision-title>Cargando…</h1><p data-revision-meta></p></div></header><div class="admin-review-comparison" data-revision-changes></div><div class="admin-field"><label for="review-comment">Comentario de revisión</label><textarea id="review-comment" maxlength="500" data-review-comment></textarea><small>Opcional al aprobar; obligatorio al rechazar.</small></div><p data-review-message role="status"></p><div class="admin-form-actions"><button class="admin-primary-action" data-review-action="approve">Aprobar</button><button class="admin-danger-action" data-review-action="reject">Rechazar</button><button class="admin-secondary-action" data-review-action="cancel">Cancelar revisión</button><a href="/admin/revisiones/">Volver</a></div></section><script src="../../../../scripts/admin-revision-detail.js"></script></AdminLayout>
