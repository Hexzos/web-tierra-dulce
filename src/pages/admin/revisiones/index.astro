---
import AdminLayout from'../../../layouts/AdminLayout.astro';import{getDevelopmentProfiles}from'../../../lib/admin/adminData.js';const profiles=getDevelopmentProfiles();
---
<AdminLayout title="Revisiones" currentPath="/admin/revisiones/" profiles={profiles}><section class="admin-products" data-revisions><header class="admin-page-header"><div><p class="admin-eyebrow">Flujo editorial</p><h1>Revisiones</h1><p>Solicitudes editoriales pendientes y resueltas.</p></div></header><div class="admin-history-tabs" role="tablist"><button data-revision-status="pending" aria-selected="true">Pendientes</button><button data-revision-status="approved">Aprobadas</button><button data-revision-status="rejected">Rechazadas</button><button data-revision-status="cancelled">Canceladas</button></div><div class="admin-field"><label for="revision-search">Buscar</label><input id="revision-search" type="search" placeholder="Producto, editor o estado" data-revision-search /></div><p data-revision-message role="status">Cargando…</p><div class="admin-product-list" data-revision-list></div></section><script src="../../../scripts/admin-revisions.js"></script></AdminLayout>
