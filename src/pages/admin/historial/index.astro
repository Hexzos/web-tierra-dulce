---
import AdminLayout from '../../../layouts/AdminLayout.astro';import{getDevelopmentProfiles}from'../../../lib/admin/adminData.js';const profiles=getDevelopmentProfiles();
---
<AdminLayout title="Historial" currentPath="/admin/historial/" profiles={profiles}><section class="admin-products" data-history><header class="admin-page-header"><div><p class="admin-eyebrow">Auditoría</p><h1>Historial</h1><p>Registro cronológico local de cambios administrativos.</p></div></header><div class="admin-history-tabs" role="tablist"><button role="tab" aria-selected="true" data-history-type="product">Productos</button><button role="tab" aria-selected="false" data-history-type="category">Categorías</button><button role="tab" aria-selected="false" data-history-type="user" data-developer-admin-only>Usuarios</button></div><div class="admin-field"><label for="history-search">Buscar</label><input id="history-search" type="search" placeholder="Entidad, usuario o acción" data-history-search /></div><p data-history-message role="status">Cargando…</p><ol class="admin-history-list" data-history-list></ol></section><script src="../../../scripts/admin-history.js"></script></AdminLayout>
