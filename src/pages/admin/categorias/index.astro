---
import AdminLayout from '../../../layouts/AdminLayout.astro';import{getDevelopmentProfiles}from'../../../lib/admin/adminData.js';const profiles=getDevelopmentProfiles();
---
<AdminLayout title="Categorías" currentPath="/admin/categorias/" profiles={profiles}><section class="admin-products" data-admin-categories><header class="admin-page-header"><div><p class="admin-eyebrow">Catálogo</p><h1>Categorías</h1></div><a class="admin-primary-action" href="/admin/categorias/nueva/">Nueva categoría</a></header><div class="admin-product-tools"><div class="admin-field"><label>Buscar</label><input type="search" data-category-search /></div><div class="admin-field"><label>Estado</label><select data-category-status><option value="">Todos</option><option value="active">Activa</option><option value="hidden">Oculta</option><option value="archived">Archivada</option></select></div></div><p data-category-message role="status">Cargando…</p><div class="admin-product-list" data-category-list></div></section><script src="../../../scripts/admin-categories.js"></script></AdminLayout>
